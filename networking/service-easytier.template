#!/bin/bash
# EasyTier node for Batocera — rendered by install.sh (RetroLobby)
[ "$1" = "start" ] || [ "$1" = "stop" ] || exit 0

DIR=/userdata/system/easytier
LOG=/userdata/system/logs/easytier.log

if [ "$1" = "stop" ]; then
  pkill -x easytier-core
  exit 0
fi

[ -x $DIR/easytier-core ] || exit 0
pgrep -x easytier-core >/dev/null && exit 0

mkdir -p /userdata/system/logs
setsid $DIR/easytier-core @@IPMODE@@ \
  --hostname @@HOSTNAME@@ \
  --network-name @@NET_NAME@@ \
  --network-secret @@NET_SECRET@@ \
  -p tcp://225284.xyz:11010 \
  -p udp://et.basd1.de:11010 >>$LOG 2>&1 </dev/null &
exit 0
